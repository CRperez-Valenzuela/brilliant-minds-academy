+  const propio = new AppError(500, 'PROPIO', 'ya era un AppError');
+  const rel = await fallo(crearWhatsappService({ http: { post: async () => { throw propio; } }, token: 't', phoneId: 'p', version: 'v1' }));
+  assert.equal(rel, propio);
+});
