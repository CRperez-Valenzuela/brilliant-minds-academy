@@ -0,0 +1,31 @@
+'use strict';
+const { ejecutar } = require('../../config/db');
+const { e } = require('../../errors/AppError');
+const { guard: guardGlobal } = require('./guard');
+
+const DIAS_PRUEBA = 15;
+
+/**
+ * Activa la prueba gratuita de 15 días de un módulo Premium: escribe la ventana [NOW(), NOW() + 15 días) en modulos_premium.
+ * Un solo UPDATE condicional y atómico: solo prospera si el módulo NO está contratado y la prueba NO se usó antes (una por módulo),
+ * así dos clics simultáneos no extienden la ventana. El vencimiento no necesita tarea de limpieza: el guard compara contra NOW().
+ */
+async function activarPrueba(codigo, { guard = guardGlobal, dias = DIAS_PRUEBA } = {}) {
+  const r = await ejecutar(
+    `UPDATE modulos_premium
+        SET prueba_inicio = NOW(), prueba_expira_en = NOW() + make_interval(days => $2::int), prueba_usada = TRUE, actualizado_en = NOW()
+      WHERE codigo = $1 AND habilitado = FALSE AND prueba_usada = FALSE
+      RETURNING codigo, nombre, prueba_inicio, prueba_expira_en`,
+    [codigo, dias]);
+  if (!r.rowCount) {
+    const m = await ejecutar('SELECT habilitado, prueba_expira_en FROM modulos_premium WHERE codigo = $1', [codigo]);
+    if (!m.rowCount) throw e.noEncontrado('El módulo');
+    if (m.rows[0].habilitado) throw e.conflicto('MODULO_YA_CONTRATADO', 'El módulo ya está contratado: no necesita prueba.');
+    throw e.conflicto('PRUEBA_YA_UTILIZADA', 'La prueba gratuita de este módulo ya fue utilizada.', { prueba_expira_en: m.rows[0].prueba_expira_en });
+  }
+  guard.invalidar(); // el candado debe ver la prueba de inmediato (no esperar el TTL de la caché)
+  const f = r.rows[0];
+  return { modulo: f.codigo, nombre: f.nombre, dias, prueba_inicio: f.prueba_inicio, prueba_expira_en: f.prueba_expira_en };
+}
+
+module.exports = { activarPrueba, DIAS_PRUEBA };
