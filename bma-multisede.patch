+  const armados = [];
+  const cancelados = [];
+  const ciclos = [];
+  const log = { log() {}, error() {} };
+  const c = iniciarCron({
+    ahora: () => reloj, hora: 8, log,
+    ciclo: async (o) => { ciclos.push(o); },
+    programar: (fn, ms) => { const h = { fn, ms, unref() {} }; armados.push(h); return h; },
+    cancelar: (h) => cancelados.push(h),
+  });
+  assert.equal(armados.length, 1);
+  assert.equal(armados[0].ms, 3_600_000, 'espera exactamente 1 h hasta las 08:00');
+  reloj = Date.parse('2026-10-24T12:00:00.100Z');
+  await armados[0].fn();
+  assert.equal(ciclos.length, 1);
+  assert.equal(armados.length, 2, 'se rearma tras cada ciclo');
+  assert.equal(armados[1].ms, 86_400_000 - 100, 'siguiente: mañana a las 08:00, calculado desde el reloj real');
+  c.detener();
+  assert.deepEqual(cancelados, [armados[1]]);
+  await armados[1].fn(); // un disparo tardío tras detener no debe rearmar
