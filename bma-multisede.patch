+test('cron: la próxima ejecución es siempre las 08:00 de Caracas (12:00 UTC), estrictamente posterior a "ahora"', () => {
+  const iso = (ms) => new Date(ms).toISOString();
+  assert.equal(iso(proximaEjecucionCaracas(Date.parse('2026-10-24T11:59:59Z'))), '2026-10-24T12:00:00.000Z'); // 07:59:59 en Caracas
+  assert.equal(iso(proximaEjecucionCaracas(Date.parse('2026-10-24T12:00:00Z'))), '2026-10-25T12:00:00.000Z'); // justo a las 08:00 → mañana
+  assert.equal(iso(proximaEjecucionCaracas(Date.parse('2026-10-24T20:30:00Z'))), '2026-10-25T12:00:00.000Z');
+  // 22:00 del 23/oct en Caracas (= 02:00Z del 24) → hoy (24 UTC) a las 12:00Z, que es el 24 a las 08:00 de Caracas
+  assert.equal(iso(proximaEjecucionCaracas(Date.parse('2026-10-24T02:00:00Z'))), '2026-10-24T12:00:00.000Z');
+  // cambio de mes y de año
+  assert.equal(iso(proximaEjecucionCaracas(Date.parse('2026-12-31T13:00:00Z'))), '2027-01-01T12:00:00.000Z');
