+'use strict';
+// Ejecuta UN ciclo de alertas automáticas de WhatsApp (módulo premium WHATSAPP_AUTOMATICO) y termina.
+// Pensado para un programador externo (cron del sistema, Supabase pg_cron → webhook, Render/Railway cron) en lugar del temporizador
+// interno (CRON_WHATSAPP=false en el servidor). Uso:
+//   npm run cron:whatsapp                 # respeta la reclamación diaria: no repite el mismo día
+//   npm run cron:whatsapp -- --forzar     # reejecuta hoy (el control anti-duplicado por estudiante sigue vigente)
+const { ejecutarCiclo } = require('../modules/premium/whatsapp-cron');
+const { closePool } = require('../config/db');
+
+ejecutarCiclo({ forzar: process.argv.includes('--forzar') })
+  .then((r) => { console.log(JSON.stringify(r)); })
+  .catch((err) => { console.error('Ciclo fallido:', err.message); process.exitCode = 1; })
+  .finally(() => closePool());
