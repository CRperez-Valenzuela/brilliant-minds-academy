--- /dev/null
+++ b/modules/premium/whatsapp-cron.js
@@ -0,0 +1,147 @@
+'use strict';
+/**
+ * Módulo Premium WHATSAPP_AUTOMATICO — tarea programada diaria (08:00, hora de Caracas) que despacha, sede por sede y de forma
+ * SECUENCIAL, las alertas Preventiva (3–5 días antes del vencimiento) y de Morosidad a las familias, con una pausa de 1,5 s entre
+ * mensajes para no saturar la API de Meta. Sin dependencias nuevas: un temporizador en proceso + una reclamación diaria atómica en la
+ * base de datos, de modo que varias instancias del servidor (o un reinicio a las 08:00) envían UNA sola vez al día.
+ *
+ *   · El candado Premium se evalúa en cada ciclo: si la prueba de 15 días venció (o el módulo no está contratado) no se envía nada.
+ *   · Reutiliza notificaciones.service.generarAlerta (mismas reglas, plantillas, tasa BCV fresca y registro en notificaciones_whatsapp).
+ *   · Un fallo individual (teléfono inválido, Meta caída) se cuenta y se sigue con la siguiente familia.
+ */
+const { ejecutar } = require('../../config/db');
+const cfg = require('../../config/env');
+const { AppError } = require('../../errors/AppError');
+const { aFechaSql, hoyCaracas, proximaEjecucionCaracas } = require('../../utils/fechas');
+const { guard: guardGlobal } = require('./guard');
+const notificaciones = require('../../services/notificaciones.service');
+
+const MODULO = 'WHATSAPP_AUTOMATICO';
+const CLAVE_ULTIMO_DIA = 'CRON_WA_ULTIMO_DIA';
+const PAUSA_MS_DEFECTO = 1500;
+const MAX_TIMEOUT_MS = 2_147_483_647;
+
+const dormir = (ms) => new Promise((r) => { setTimeout(r, ms); });
+
+/**
+ * Reclama el día `hoy` ('AAAA-MM-DD'): el INSERT … ON CONFLICT … WHERE solo escribe (y devuelve fila) si el valor guardado es OTRO día.
+ * Dos instancias a la vez: la segunda no obtiene fila → no envía. Devuelve true si este proceso es el que debe ejecutar el ciclo.
+ */
+async function reclamarDia(hoy) {
+  const r = await ejecutar(
+    `INSERT INTO parametros (clave, valor) VALUES ($1, $2)
+     ON CONFLICT (clave) DO UPDATE SET valor = EXCLUDED.valor, actualizado_en = NOW()
+       WHERE parametros.valor <> EXCLUDED.valor
+     RETURNING valor`,
+    [CLAVE_ULTIMO_DIA, hoy]);
+  return r.rowCount > 0;
+}
+
+/**
+ * Estudiantes de una sede (NULL = estudiantes sin sede asignada) con alerta pendiente de enviar hoy: en el estado dinámico pedido, con
+ * (opcional) una cuota por vencer en la ventana, y SIN una notificación de ese tipo ya generada hoy (evita duplicar con envíos manuales).
+ */
+async function candidatos({ sedeId, estado, tipo, hoy, ventana }) {
+  const conVentana = Boolean(ventana);
+  const r = await ejecutar(
+    `SELECT v.id FROM vw_estudiantes_estado v
+      WHERE v.estado_dinamico = $2::text
+        AND v.sede_id IS NOT DISTINCT FROM $1::int
+        AND ($3::boolean = FALSE OR EXISTS (
+              SELECT 1 FROM cuotas c
+               WHERE c.estudiante_id = v.id AND c.estado = 'Pendiente' AND c.fecha_vencimiento BETWEEN $4::date AND $5::date))
+        AND NOT EXISTS (
+              SELECT 1 FROM notificaciones_whatsapp n
+               WHERE n.estudiante_id = v.id AND n.tipo = $6::text AND n.estado <> 'FALLIDA'
+                 AND (n.creado_en AT TIME ZONE 'America/Caracas')::date = $7::date)
+      ORDER BY v.id`,
+    [sedeId, estado, conVentana, ventana ? aFechaSql(ventana.desde) : null, ventana ? aFechaSql(ventana.hasta) : null, tipo, aFechaSql(hoy)]);
+  return r.rows.map((f) => f.id);
+}
+
+/** Suma `dias` a una fecha 'AAAA-MM-DD' (calendario, sin huso). */
+function sumarDias(fecha, dias) {
+  const [y, m, d] = fecha.split('-').map(Number);
+  return new Date(Date.UTC(y, m - 1, d + dias)).toISOString().slice(0, 10);
+}
+
+/**
+ * Un ciclo completo. `forzar: true` omite la reclamación diaria (reejecución manual; el control anti-duplicado por estudiante sigue vigente).
+ * Devuelve el resumen { omitido? , sedes, enviadas, omitidas, fallidas }.
+ */
+async function ejecutarCiclo({ ahora = Date.now, forzar = false, guard = guardGlobal, servicio = notificaciones, pausaMs = cfg.cron.pausaMs, esperar = dormir, log = console } = {}) {
+  const hoy = hoyCaracas(ahora());
+  const modulo = await guard.estado(MODULO);
+  if (!modulo.activo) {
+    log.log(`[cron-whatsapp] ${hoy}: módulo ${MODULO} inactivo (no contratado o prueba vencida); no se envía nada.`);
+    return { omitido: 'MODULO_INACTIVO', enviadas: 0, omitidas: 0, fallidas: 0 };
+  }
+  if (!forzar && !(await reclamarDia(hoy))) {
+    log.log(`[cron-whatsapp] ${hoy}: el ciclo de hoy ya fue reclamado por otra ejecución.`);
+    return { omitido: 'YA_EJECUTADO_HOY', enviadas: 0, omitidas: 0, fallidas: 0 };
+  }
+
+  const sedes = (await ejecutar('SELECT id FROM sedes WHERE activa = TRUE ORDER BY id')).rows.map((s) => s.id);
+  const resumen = { sedes: 0, enviadas: 0, omitidas: 0, fallidas: 0 };
+  const ventana = { desde: sumarDias(hoy, notificaciones.VENTANA_PREVENTIVA.min), hasta: sumarDias(hoy, notificaciones.VENTANA_PREVENTIVA.max) };
+
+  // [...sedes, null]: el último pase atiende a las familias aún sin sede asignada (datos anteriores a la migración multi-sede).
+  for (const sedeId of [...sedes, null]) {
+    resumen.sedes += 1;
+    const pasos = [
+      { tipo: 'PREVENTIVA', estado: 'Activo', ventana },
+      { tipo: 'MOROSIDAD', estado: 'Moroso', ventana: null },
+    ];
+    for (const paso of pasos) {
+      const ids = await candidatos({ sedeId, estado: paso.estado, tipo: paso.tipo, hoy, ventana: paso.ventana });
+      for (const estudianteId of ids) {
+        let intentoEnvio = true;
+        try {
+          await servicio.generarAlerta({ tipo: paso.tipo, estudianteId, enviar: true, usuarioId: null, sedeId });
+          resumen.enviadas += 1;
+        } catch (err) {
+          if (err instanceof AppError && err.status === 422) {
+            resumen.omitidas += 1; // regla de negocio (fuera de ventana, pago en revisión…): no hubo mensaje
+            intentoEnvio = false;
+          } else {
+            resumen.fallidas += 1;
+            log.error(`[cron-whatsapp] ${paso.tipo} estudiante ${estudianteId} (sede ${sedeId ?? 'sin sede'}): ${err.detalles?.motivo || err.message}`);
+          }
+        }
+        if (intentoEnvio) await esperar(pausaMs); // 1,5 s entre mensajes
+      }
+    }
+  }
+  log.log(`[cron-whatsapp] ${hoy}: enviadas=${resumen.enviadas} omitidas=${resumen.omitidas} fallidas=${resumen.fallidas}`);
+  return resumen;
+}
+
+/**
+ * Programa el ciclo diario a las `hora`:00 de Caracas. Devuelve { detener, proxima() }. El temporizador no mantiene vivo el proceso.
+ * Tras cada disparo recalcula la siguiente ocurrencia desde el reloj real (no acumula deriva).
+ */
+function iniciarCron({ ahora = Date.now, hora = cfg.cron.hora, ciclo = ejecutarCiclo, programar = setTimeout, cancelar = clearTimeout, log = console } = {}) {
+  let temporizador = null;
+  let detenido = false;
+  const proxima = () => proximaEjecucionCaracas(ahora(), hora, 0);
+
+  function armar() {
+    if (detenido) return;
+    const espera = Math.max(0, Math.min(proxima() - ahora(), MAX_TIMEOUT_MS));
+    temporizador = programar(async () => {
+      try {
+        await ciclo({ ahora });
+      } catch (err) {
+        log.error('[cron-whatsapp] El ciclo diario falló:', err.message);
+      } finally {
+        armar();
+      }
+    }, espera);
+    if (temporizador && typeof temporizador.unref === 'function') temporizador.unref();
+  }
+  armar();
+  log.log(`[cron-whatsapp] Programado: diario a las ${String(hora).padStart(2, '0')}:00 (hora de Caracas). Próxima: ${new Date(proxima()).toISOString()}`);
+  return { detener() { detenido = true; if (temporizador) cancelar(temporizador); }, proxima };
+}
+
+module.exports = { ejecutarCiclo, iniciarCron, reclamarDia, candidatos, sumarDias, MODULO, CLAVE_ULTIMO_DIA, PAUSA_MS_DEFECTO };
