+/**
+ * Instante (ms epoch UTC) de la PRÓXIMA ocurrencia estrictamente posterior a `ahora` de las `hora`:`minuto` de pared en Caracas.
+ * Caracas = UTC-4 fijo → 08:00 en Caracas = 12:00 UTC (sin horario de verano, el cálculo es exacto todo el año).
+ */
+function proximaEjecucionCaracas(ahora = Date.now(), hora = 8, minuto = 0) {
+  const caracas = new Date(ahora - OFFSET_CARACAS_MS); // reloj de pared de Caracas, leído con los getters UTC
+  let objetivo = Date.UTC(caracas.getUTCFullYear(), caracas.getUTCMonth(), caracas.getUTCDate(), hora, minuto) + OFFSET_CARACAS_MS;
+  if (objetivo <= ahora) objetivo += 86_400_000;
+  return objetivo;
+}
+
+module.exports = { proximaEjecucionCaracas, hoyCaracas, esFechaValida, aFechaSql, aInstanteSql, diasEntre, periodoActual, esPeriodoValido, limitesPeriodo };
