+DECLARE
+  -- (tabla, nombre, definición): solo se crea si el nombre aún no existe en el catálogo.
+  r RECORD;
+BEGIN
+  FOR r IN
+    SELECT * FROM (VALUES
+      ('estudiantes',   'ck_estudiantes_tratamiento_len',
