# ── Servidor ──────────────────────────────────────────────
NODE_ENV=development
PORT=3000
PORTAL_BASE_URL=http://localhost:3000
CORS_ORIGIN=
ACADEMIA_NOMBRE=Brilliant Minds Academy

# ── Autenticación del panel (>= 32 caracteres en producción) ──
JWT_SECRET=
JWT_EXPIRES_IN=8h

# ── PostgreSQL · Supabase (paquete `pg`) ──────────────────
# Dashboard de Supabase → Connect. Usa el "Session pooler" (puerto 5432) o la conexión directa.
#   DB_SERVER   host, p. ej. aws-0-<region>.pooler.supabase.com  (directa: db.<ref>.supabase.co)
#   DB_USER     con el pooler es "postgres.<ref-del-proyecto>"; con la directa, "postgres"
#   DB_NAME     normalmente "postgres"
DB_SERVER=
DB_PORT=5432
DB_NAME=postgres
DB_USER=
DB_PASSWORD=
# Supabase exige TLS. Para verificar el certificado, descarga la CA del proyecto
# (Project Settings → Database → SSL Configuration) y guarda el archivo FUERA del repositorio.
DB_SSL=true
DB_SSL_CA_PATH=
DB_SSL_REJECT_UNAUTHORIZED=true
DB_POOL_MAX=10
DB_POOL_MIN=0
DB_POOL_IDLE_MS=30000
DB_REQUEST_TIMEOUT_MS=30000
DB_CONNECT_TIMEOUT_MS=15000

# ── Google Drive (cuenta de servicio + carpeta en UNIDAD COMPARTIDA) ──
# JSON en una línea o ruta a un archivo FUERA del repositorio.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_DRIVE_PARENT_FOLDER_ID=

# ── Tasa BCV ──────────────────────────────────────────────
BCV_API_URL=https://ve.dolarapi.com/v1/dolares/oficial
BCV_TIMEOUT_MS=6000
BCV_MAX_ANTIGUEDAD_HORAS=24

# ── WhatsApp Business (Meta Cloud API) ────────────────────
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
GRAPH_API_VERSION=v20.0

# ── Admisiones (cargas simultáneas) ───────────────────────
ADMISIONES_MAX_ARCHIVO_MB=5
ADMISIONES_CONCURRENCIA_MAX=4

# ── Solo para `npm run crear-admin` (no dejar en .env permanente) ──
# ADMIN_NOMBRE=
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
