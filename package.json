{
  "name": "brilliant-minds-academy-core",
  "version": "1.0.0",
  "description": "Sistema de Gestión Académica, Admisiones y Cobranza - Astra Digital Solutions",
  "main": "server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "migrate": "node scripts/migrate.js",
    "crear-admin": "node scripts/crear-admin.js",
    "cron:whatsapp": "node cron/whatsappCron.js",
    "cron:whatsapp:daemon": "node cron/whatsappCron.js --daemon",
    "test": "node --test tests/*.test.js",
    "test:integracion": "node --test tests/integracion.pg.test.js",
    "frontend:install": "npm --prefix frontend install",
    "frontend:build": "npm --prefix frontend run build",
    "frontend:dev": "npm --prefix frontend run dev"
  },
  "keywords": [
    "express",
    "supabase",
    "postgresql",
    "google-drive",
    "academy",
    "crm"
  ],
  "author": "Astra Digital Solutions",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.7.7",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.21.1",
    "googleapis": "^144.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "autoprefixer": "^10.6.1",
    "nodemon": "^3.1.7",
    "postcss": "^8.5.31",
    "tailwindcss": "^4.3.3",
    "terser": "^5.51.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
