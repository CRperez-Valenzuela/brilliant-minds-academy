+const ARCHIVOS: readonly DefArchivo[] = [
+  { campo: 'foto_carnet', etiqueta: 'Foto carnet', mimes: ['image/jpeg', 'image/png'], extensiones: ['jpg', 'jpeg', 'png'], accept: 'image/jpeg,image/png', formatos: 'JPG o PNG' },
